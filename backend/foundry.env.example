# Copy to backend/.env.foundry (ignored by Git). No model API key is needed here.
AI_PROVIDER=foundry-agent
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
FOUNDRY_AGENT_NAME=matchlens-connection-test
FOUNDRY_AGENT_VERSION=2
FOUNDRY_MODEL_DEPLOYMENT_NAME=matchlens-openai/gpt-6-luna
AI_ENABLED=false
AI_MAX_OUTPUT_TOKENS=800
AI_TIMEOUT_MS=45000
# Comma-separated browser origins; configure explicitly before deployment.
AI_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# The earlier direct Azure OpenAI adapter is optional and inactive in this mode.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your-deployment
# AZURE_OPENAI_API_KEY=
