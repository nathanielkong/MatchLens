{
  "name": "@matchlens/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/synthetic/seed.ts",
    "test": "tsx --test src/tests/*.test.ts",
    "db:verify": "tsx src/db/verify.ts",
    "db:finalise": "tsx src/synthetic/finalise.ts",
    "db:test": "tsx src/tests/database.integration.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15"
  }
}
