NODE_ENV=production
HOST=0.0.0.0
PORT=8080
# Inject a generated stable secret and the restricted database connection from the host secret store.
SESSION_SECRET=replace_with_at_least_32_random_characters
APP_DATABASE_URL=replace_with_restricted_postgresql_connection
AI_PROVIDER=foundry-agent
AI_ENABLED=true
PUBLIC_AI_ENABLED=false
AI_PERSIST_CONVERSATIONS=true
AI_MAX_OUTPUT_TOKENS=2000
AI_LONG_OUTPUT_TOKENS=6000
AI_REVIEW_OUTPUT_TOKENS=4000
AI_ALLOWED_ORIGINS=https://replace-with-your-public-host
FOUNDRY_PROJECT_ENDPOINT=https://replace.services.ai.azure.com/api/projects/replace
FOUNDRY_AGENT_NAME=replace
FOUNDRY_AGENT_VERSION=2
FOUNDRY_MODEL_DEPLOYMENT_NAME=replace/replace
# Optional user-assigned managed identity. The host identity needs Foundry access.
AZURE_CLIENT_ID=
